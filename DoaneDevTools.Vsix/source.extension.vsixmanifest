<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
                 xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="DoaneDevTools.1a2b3c4d-5e6f-7890-abcd-ef1234567890"
              Version="1.0.0"
              Language="en-US"
              Publisher="Doane University IT Development" />
    <DisplayName>DoaneDevTools — Doane Developer Extension</DisplayName>
    <Description xml:space="preserve">Roslyn analyzers, code fixes, dependency mapping, env manager, template builder, and debug visualizers for Doane University development standards.</Description>
    <MoreInfo>https://github.com/tfinnerdu/vs-tools</MoreInfo>
    <Tags>code-analysis roslyn analyzers productivity doane</Tags>
  </Metadata>
  <Installation AllUsers="false">
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0,18.0)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Professional" Version="[17.0,18.0)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.0,18.0)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[18.0,19.0)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Professional" Version="[18.0,19.0)" />
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[18.0,19.0)" />
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName=".NET Framework 4.8" Version="[4.8,)" />
    <Dependency Id="Microsoft.VisualStudio.Component.CoreEditor"
                DisplayName="Visual Studio core editor"
                Version="[17.0,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor"
                  DisplayName="Visual Studio core editor"
                  Version="[17.0,)" />
  </Prerequisites>
  <Assets>
    <!-- Main VS Package -->
    <Asset Type="Microsoft.VisualStudio.VsPackage"
           d:Source="Project"
           d:ProjectName="DoaneDevTools.Vsix"
           Path="|DoaneDevTools.Vsix|pkgdef" />
    <!-- MEF components from the VSIX assembly -->
    <Asset Type="Microsoft.VisualStudio.MefComponent"
           d:Source="Project"
           d:ProjectName="DoaneDevTools.Vsix"
           Path="|DoaneDevTools.Vsix|" />
    <!-- MEF components from the ToolWindows assembly -->
    <Asset Type="Microsoft.VisualStudio.MefComponent"
           d:Source="Project"
           d:ProjectName="DoaneDevTools.ToolWindows"
           Path="|DoaneDevTools.ToolWindows|" />
    <!-- MEF components from the Visualizers assembly -->
    <Asset Type="Microsoft.VisualStudio.MefComponent"
           d:Source="Project"
           d:ProjectName="DoaneDevTools.Visualizers"
           Path="|DoaneDevTools.Visualizers|" />
  </Assets>
</PackageManifest>
