<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>DoaneAnalyzers</PackageId>
    <Version>1.0.0</Version>
    <Authors>Doane University IT</Authors>
    <Description>Roslyn analyzers and code fixes for Doane University development standards.</Description>
    <PackageTags>roslyn analyzer doane csharp</PackageTags>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/tfinnerdu/vs-tools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tfinnerdu/vs-tools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © Doane University</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DoaneDevTools.Analyzers\DoaneDevTools.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <!-- Place the analyzer DLL in the NuGet analyzers folder -->
  <ItemGroup>
    <None Include="..\DoaneDevTools.Analyzers\bin\$(Configuration)\netstandard2.0\DoaneDevTools.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
    <None Include="..\DoaneDevTools.Analyzers\bin\$(Configuration)\netstandard2.0\DoaneDevTools.Analyzers.pdb"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false"
          Condition="Exists('..\DoaneDevTools.Analyzers\bin\$(Configuration)\netstandard2.0\DoaneDevTools.Analyzers.pdb')" />
  </ItemGroup>
  <!-- Include build props so consuming projects suppress CS8032 -->
  <ItemGroup>
    <None Include="build\DoaneAnalyzers.props" Pack="true" PackagePath="build" Visible="false" />
  </ItemGroup>
</Project>
