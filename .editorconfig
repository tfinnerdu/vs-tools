root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
tab_width = 4

# Naming: interfaces start with I
dotnet_naming_rule.interfaces_should_start_with_I.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_start_with_I.style = prefix_i_style
dotnet_naming_rule.interfaces_should_start_with_I.severity = suggestion
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_style.required_prefix = I
dotnet_naming_style.prefix_i_style.capitalization = pascal_case

# Naming: private fields use _camelCase
dotnet_naming_rule.private_fields_camel.symbols = private_field_symbols
dotnet_naming_rule.private_fields_camel.style = underscore_camel_style
dotnet_naming_rule.private_fields_camel.severity = suggestion
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_style.required_prefix = _
dotnet_naming_style.underscore_camel_style.capitalization = camel_case

# Roslyn analyzer severities — enforce Doane standards
dotnet_diagnostic.DA004.severity = error
dotnet_diagnostic.DS003.severity = error
dotnet_diagnostic.DS006.severity = warning
dotnet_diagnostic.DSSEC.severity = warning

# var preferences
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Null checking
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.ps1]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
