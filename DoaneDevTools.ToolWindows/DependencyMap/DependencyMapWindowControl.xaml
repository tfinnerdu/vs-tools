<UserControl
    x:Class="DoaneDevTools.ToolWindows.DependencyMap.DependencyMapWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:DoaneDevTools.ToolWindows.DependencyMap"
    xmlns:models="clr-namespace:DoaneDevTools.ToolWindows.DependencyMap.Models"
    mc:Ignorable="d"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <UserControl.Resources>

        <!-- Node colour based on cycle / impact state -->
        <SolidColorBrush x:Key="NodeDefaultBrush"  Color="#1F3864"/>
        <SolidColorBrush x:Key="NodeCycleBrush"    Color="#CC0000"/>
        <SolidColorBrush x:Key="NodeImpactBrush"   Color="#FF7900"/>
        <SolidColorBrush x:Key="NodeTextBrush"     Color="White"/>
        <SolidColorBrush x:Key="EdgeBrush"         Color="#555555"/>
        <SolidColorBrush x:Key="EdgeInheritBrush"  Color="#569CD6"/>
        <SolidColorBrush x:Key="EdgeImplBrush"     Color="#4EC9B0"/>

        <!-- Node rectangle data-template -->
        <DataTemplate x:Key="NodeTemplate" DataType="{x:Type models:GraphNode}">
            <Border Width="{Binding Width}"
                    Height="{Binding Height}"
                    CornerRadius="4"
                    BorderThickness="1.5"
                    BorderBrush="White"
                    ToolTip="{Binding FullName}"
                    Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource NodeDefaultBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInCycle}"  Value="True">
                                <Setter Property="Background" Value="{StaticResource NodeCycleBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsImpacted}" Value="True">
                                <Setter Property="Background" Value="{StaticResource NodeImpactBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Name}"
                           Foreground="{StaticResource NodeTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Margin="4,2"/>
            </Border>
        </DataTemplate>

        <!-- Edge line is drawn in code-behind on Canvas; this template is for the
             right-panel list. -->
        <DataTemplate x:Key="EdgeListTemplate" DataType="{x:Type models:GraphEdge}">
            <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock Text="{Binding SourceId}" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                <TextBlock Text=" → " FontFamily="Consolas" FontSize="11" Foreground="Gray"/>
                <TextBlock Text="{Binding TargetId}" FontFamily="Consolas" FontSize="11"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                <TextBlock Text=" [" Foreground="Gray" FontSize="10"/>
                <TextBlock Text="{Binding Type}" Foreground="#569CD6" FontSize="10"/>
                <TextBlock Text="]" Foreground="Gray" FontSize="10"/>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Main content area -->
            <RowDefinition Height="*"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====================================================================
             ROW 0 — Toolbar
             ==================================================================== -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">

            <!-- Scope selector -->
            <TextBlock Text="Scope:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox x:Name="ScopeCombo"
                      Width="110"
                      SelectedIndex="2"
                      SelectionChanged="ScopeCombo_SelectionChanged"
                      IsEnabled="{Binding IsBusy,
                          Converter={x:Static local:DependencyMapWindowControl.InverseBoolConverter}}">
                <ComboBoxItem Content="Assembly"/>
                <ComboBoxItem Content="Namespace"/>
                <ComboBoxItem Content="Type" IsSelected="True"/>
                <ComboBoxItem Content="Method"/>
            </ComboBox>

            <Separator/>

            <!-- Depth slider -->
            <TextBlock Text="Depth:" VerticalAlignment="Center" Margin="4,0"/>
            <Slider x:Name="DepthSlider"
                    Minimum="1" Maximum="4" Value="{Binding Depth}"
                    Width="80" TickFrequency="1" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Depth}" VerticalAlignment="Center" Margin="4,0" Width="12"/>

            <Separator/>

            <!-- Metrics overlay -->
            <TextBlock Text="Metrics:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox x:Name="MetricsCombo"
                      Width="120"
                      SelectedValue="{Binding MetricsOverlay}"
                      SelectedValuePath="Content">
                <ComboBoxItem Content="None" IsSelected="True"/>
                <ComboBoxItem Content="LOC"/>
                <ComboBoxItem Content="Complexity"/>
                <ComboBoxItem Content="Coupling"/>
            </ComboBox>

            <Separator/>

            <!-- Build graph -->
            <Button Content="Build Graph"
                    Command="{Binding BuildGraphCommand}"
                    Padding="8,2"
                    Background="#1F3864"
                    Foreground="White"
                    FontWeight="SemiBold"/>

            <Separator/>

            <!-- Impact query -->
            <Button Content="What breaks if I change this?"
                    Command="{Binding ShowImpactCommand}"
                    CommandParameter="{Binding SelectedNode}"
                    Padding="8,2"
                    ToolTip="Highlight all types transitively impacted by the selected node"/>

            <Button Content="Clear Impact"
                    Command="{Binding ClearImpactCommand}"
                    Padding="6,2"
                    Margin="4,0,0,0"/>
        </ToolBar>

        <!-- ====================================================================
             ROW 1 — Main content: Canvas + Right panel
             ==================================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Graph canvas -->
                <ColumnDefinition Width="*" MinWidth="400"/>
                <!-- Splitter -->
                <ColumnDefinition Width="5"/>
                <!-- Detail panel -->
                <ColumnDefinition Width="260" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- ── Graph Canvas ─────────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    BorderThickness="1"
                    Margin="4,4,0,4"
                    ClipToBounds="True">
                <ScrollViewer x:Name="CanvasScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <!-- The graph canvas. Edges are drawn as Lines by code-behind.
                         Nodes are hosted in an ItemsControl so the ViewModel collection
                         drives their placement via Canvas.Left / Canvas.Top. -->
                    <Canvas x:Name="GraphCanvas"
                            Width="{Binding CanvasWidth, FallbackValue=1200}"
                            Height="{Binding CanvasHeight, FallbackValue=800}"
                            Background="#0D1117"
                            MouseDown="GraphCanvas_MouseDown"
                            MouseMove="GraphCanvas_MouseMove"
                            MouseUp="GraphCanvas_MouseUp"
                            MouseWheel="GraphCanvas_MouseWheel">

                        <!-- Edges layer (Lines added by code-behind) -->
                        <Canvas x:Name="EdgeLayer"/>

                        <!-- Nodes layer via ItemsControl -->
                        <ItemsControl x:Name="NodesItemsControl"
                                      ItemsSource="{Binding Nodes}"
                                      ItemTemplate="{StaticResource NodeTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                        </ItemsControl>

                    </Canvas>
                </ScrollViewer>
            </Border>

            <!-- ── Grid Splitter ────────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                          ResizeDirection="Columns"
                          ShowsPreview="True"/>

            <!-- ── Right Detail Panel ───────────────────────────────────────── -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                          Margin="0,4,4,4">
                <StackPanel Margin="6">

                    <TextBlock Text="Selected Node"
                               FontWeight="Bold"
                               Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                               Margin="0,0,0,4"/>

                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" Padding="6" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock>
                                <Run FontWeight="SemiBold">Name: </Run>
                                <Run Text="{Binding SelectedNode.Name, FallbackValue='(none)'}"/>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,2">
                                <Run FontWeight="SemiBold">Full Name: </Run>
                                <Run Text="{Binding SelectedNode.FullName, FallbackValue='—'}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run FontWeight="SemiBold">Assembly: </Run>
                                <Run Text="{Binding SelectedNode.AssemblyName, FallbackValue='—'}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run FontWeight="SemiBold">LOC: </Run>
                                <Run Text="{Binding SelectedNode.LinesOfCode, FallbackValue='—'}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run FontWeight="SemiBold">Complexity: </Run>
                                <Run Text="{Binding SelectedNode.CyclomaticComplexity, FallbackValue='—'}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run FontWeight="SemiBold">Ca (afferent): </Run>
                                <Run Text="{Binding SelectedNode.AfferentCoupling, FallbackValue='—'}"/>
                            </TextBlock>
                            <TextBlock>
                                <Run FontWeight="SemiBold">Ce (efferent): </Run>
                                <Run Text="{Binding SelectedNode.EfferentCoupling, FallbackValue='—'}"/>
                            </TextBlock>
                            <TextBlock Foreground="Red">
                                <Run FontWeight="SemiBold"
                                     Visibility="{Binding SelectedNode.IsInCycle,
                                         Converter={x:Static local:DependencyMapWindowControl.BoolToVisConverter}}">
                                    ⚠ In circular dependency
                                </Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Circular Dependencies"
                               FontWeight="Bold"
                               Margin="0,4,0,4"
                               Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>

                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" Margin="0,0,0,8"
                            MaxHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CircularDependencies}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="Red"
                                                   FontFamily="Consolas" FontSize="10"
                                                   TextWrapping="Wrap" Margin="4,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="Impacted Nodes"
                               FontWeight="Bold"
                               Margin="0,4,0,4"
                               Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>

                    <Border BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            BorderThickness="1" MaxHeight="200">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ImpactedNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#FF7900"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Margin="4,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                </StackPanel>
            </ScrollViewer>

        </Grid>

        <!-- ====================================================================
             ROW 2 — Status bar
             ==================================================================== -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="80" Height="10" IsIndeterminate="True"
                             Visibility="{Binding IsBusy,
                                 Converter={x:Static local:DependencyMapWindowControl.BoolToVisConverter}}"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</UserControl>
