<UserControl x:Class="DoaneDevTools.ToolWindows.TemplateBuilder.TemplateBuilderWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="900"
             Background="#F5F5F5">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DoaneOrange" Color="#FF7900"/>
        <SolidColorBrush x:Key="DoaneNavy"  Color="#1F3864"/>

        <Style x:Key="HeaderBar" TargetType="Border">
            <Setter Property="Background" Value="#1F3864"/>
            <Setter Property="Padding"    Value="8,5"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#FF7900"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,5"/>
            <Setter Property="Margin"          Value="4,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E06A00"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"      Value="#E8EDF4"/>
            <Setter Property="Foreground"      Value="#1F3864"/>
            <Setter Property="BorderBrush"     Value="#1F3864"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="14,5"/>
            <Setter Property="Margin"          Value="4,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D8E8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#666666"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Background"  Value="#1F3864"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="6,3"/>
        </Style>

        <Style x:Key="VariableLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"    Value="0,0,8,0"/>
            <Setter Property="MinWidth"  Value="150"/>
            <Setter Property="Foreground" Value="#1F3864"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="VariableInputStyle" TargetType="TextBox">
            <Setter Property="Padding"     Value="5,3"/>
            <Setter Property="MinWidth"    Value="200"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0 — Header ────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <TextBlock Text="Template Builder — Scaffold Flask, C#, Conductor &amp; K8s services"
                       Foreground="White"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ── Row 1 — Two-panel content ─────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Template category tree -->
            <Border Grid.Column="0"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Background="White">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionLabel}"
                               Text="Templates"/>

                    <TreeView ItemsSource="{Binding TemplateCategories}"
                              SelectedItemChanged="OnTemplateSelected"
                              Background="Transparent"
                              BorderThickness="0">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Templates}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="{Binding IsCategory, Converter={x:Null}, FallbackValue=Normal}"
                                               Foreground="#1F3864"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="#DDDDDD"
                          ShowsPreview="True"/>

            <!-- Right: Template details + variable inputs -->
            <Border Grid.Column="2"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Background="White">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionLabel}">
                        <Run Text="{Binding SelectedTemplate.Name, FallbackValue='Select a template'}"/>
                    </TextBlock>

                    <!-- Template description -->
                    <Border DockPanel.Dock="Top"
                            Background="#EEF2F8"
                            Padding="8,6"
                            Margin="0,0,0,4">
                        <TextBlock Text="{Binding SelectedTemplate.Description, FallbackValue='Choose a template from the list on the left.'}"
                                   TextWrapping="Wrap"
                                   Foreground="#444444"
                                   FontStyle="Italic"/>
                    </Border>

                    <!-- Output files list -->
                    <Expander DockPanel.Dock="Top"
                              Header="Output Files"
                              IsExpanded="False"
                              Margin="8,0,8,4">
                        <ItemsControl ItemsSource="{Binding SelectedTemplate.OutputFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               Margin="8,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <!-- Separator -->
                    <Separator DockPanel.Dock="Top" Margin="8,0"/>

                    <!-- Variable input fields — dynamically generated from TemplateVariables -->
                    <ScrollViewer DockPanel.Dock="Top"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="8,8,8,4">
                        <ItemsControl ItemsSource="{Binding TemplateVariables}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Prompt}"
                                                   Style="{StaticResource VariableLabelStyle}"
                                                   ToolTip="{Binding Name}"/>

                                        <!-- Bool type → CheckBox -->
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"
                                                  Visibility="{Binding IsBool, Converter={x:Null}, FallbackValue=Collapsed}"/>

                                        <!-- String/int type → TextBox -->
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource VariableInputStyle}"
                                                 Visibility="{Binding IsText, Converter={x:Null}, FallbackValue=Visible}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Stretch filler -->
                    <Grid DockPanel.Dock="Bottom"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Row 2 — Output path + action buttons ───────────────────────── -->
        <Border Grid.Row="2"
                Background="#E8EDF4"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Output path:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="#1F3864"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Column="1"
                         Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         Padding="5,3"
                         BorderBrush="#AAAAAA"/>

                <Button Grid.Column="2"
                        Content="Browse…"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseOutputPathCommand}"
                        ToolTip="Choose an output folder"/>

                <Button Grid.Column="3"
                        Content="Preview"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding PreviewCommand}"
                        ToolTip="Show a preview of the files that will be generated"/>

                <Button Grid.Column="4"
                        Content="Generate"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding GenerateCommand}"
                        ToolTip="Scaffold the selected template into the output path"/>
            </Grid>
        </Border>

        <!-- ── Row 3 — Status bar ────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="#1F3864"
                Padding="8,3">
            <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}"
                       Foreground="White"
                       FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
