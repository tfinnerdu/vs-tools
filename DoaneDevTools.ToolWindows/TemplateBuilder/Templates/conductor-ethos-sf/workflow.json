{
  "name": "{{ workflow_name }}",
  "description": "Polls Ethos Integration for person change-events and syncs to Salesforce CRM. Generated by DoaneDevTools.",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "integration@doane.edu",
  "timeoutSeconds": 3600,
  "timeoutPolicy": "TIME_OUT_WF",
  "restartable": true,
  "inputParameters": [
    "ethosBaseUrl",
    "ethosApiKey",
    "sfInstanceUrl",
    "sfAccessToken",
    "changeEventType"
  ],
  "outputParameters": {
    "syncedCount":  "${sync_to_salesforce_ref.output.syncedCount}",
    "errorCount":   "${sync_to_salesforce_ref.output.errorCount}",
    "lastEventId":  "${poll_ethos_ref.output.lastEventId}"
  },
  "tasks": [
    {
      "name": "poll_ethos_change_events",
      "taskReferenceName": "poll_ethos_ref",
      "type": "HTTP",
      "inputParameters": {
        "http_request": {
          "uri": "${workflow.input.ethosBaseUrl}/consume-change-notifications",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer ${workflow.input.ethosApiKey}",
            "Accept": "application/json"
          },
          "connectionTimeOut": 5000,
          "readTimeOut": 30000
        }
      },
      "retryCount": 3,
      "retryLogic": "EXPONENTIAL_BACKOFF",
      "retryDelaySeconds": 5,
      "timeoutSeconds": 60,
      "timeoutPolicy": "RETRY"
    },
    {
      "name": "filter_person_events",
      "taskReferenceName": "filter_events_ref",
      "type": "INLINE",
      "inputParameters": {
        "evaluatorType": "javascript",
        "expression": "(function() { var events = $.poll_ethos_ref.output.response.body; return events.filter(function(e) { return e.resourceName === 'persons'; }); })()",
        "rawEvents": "${poll_ethos_ref.output.response.body}"
      },
      "timeoutSeconds": 10
    },
    {
      "name": "transform_ethos_to_sf",
      "taskReferenceName": "transform_ref",
      "type": "INLINE",
      "inputParameters": {
        "evaluatorType": "javascript",
        "expression": "(function() { var events = $.filter_events_ref.output.result; return events.map(function(e) { var p = e.content; return { attributes: { type: 'Contact' }, FirstName: p.names && p.names[0] ? p.names[0].firstName : '', LastName: p.names && p.names[0] ? p.names[0].lastName : 'Unknown', Email: p.emails && p.emails[0] ? p.emails[0].address : null, Doane_Person_Id__c: p.id }; }); })()",
        "personEvents": "${filter_events_ref.output.result}"
      },
      "timeoutSeconds": 15
    },
    {
      "name": "sync_to_salesforce",
      "taskReferenceName": "sync_to_salesforce_ref",
      "type": "HTTP",
      "inputParameters": {
        "http_request": {
          "uri": "${workflow.input.sfInstanceUrl}/services/data/{{ sf_api_version }}/composite/sobjects",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer ${workflow.input.sfAccessToken}",
            "Content-Type": "application/json"
          },
          "body": {
            "allOrNone": false,
            "records": "${transform_ref.output.result}"
          },
          "connectionTimeOut": 5000,
          "readTimeOut": 30000
        }
      },
      "retryCount": 2,
      "retryLogic": "FIXED",
      "retryDelaySeconds": 10,
      "timeoutSeconds": 60,
      "timeoutPolicy": "RETRY"
    },
    {
      "name": "evaluate_sync_results",
      "taskReferenceName": "evaluate_results_ref",
      "type": "INLINE",
      "inputParameters": {
        "evaluatorType": "javascript",
        "expression": "(function() { var results = $.sync_to_salesforce_ref.output.response.body; var synced = results.filter(function(r) { return r.success; }).length; var errors = results.filter(function(r) { return !r.success; }).length; return { syncedCount: synced, errorCount: errors, hasErrors: errors > 0 }; })()",
        "sfResults": "${sync_to_salesforce_ref.output.response.body}"
      },
      "timeoutSeconds": 10
    },
    {
      "name": "decide_on_errors",
      "taskReferenceName": "decide_errors_ref",
      "type": "DECISION",
      "inputParameters": {
        "hasErrors": "${evaluate_results_ref.output.result.hasErrors}"
      },
      "caseValueParam": "hasErrors",
      "decisionCases": {
        "true": [
          {
            "name": "log_sync_errors",
            "taskReferenceName": "log_errors_ref",
            "type": "HTTP",
            "inputParameters": {
              "http_request": {
                "uri": "https://hooks.example.com/alert",
                "method": "POST",
                "headers": { "Content-Type": "application/json" },
                "body": {
                  "workflow": "{{ workflow_name }}",
                  "errorCount": "${evaluate_results_ref.output.result.errorCount}",
                  "sfResults":  "${sync_to_salesforce_ref.output.response.body}"
                }
              }
            },
            "timeoutSeconds": 10
          }
        ]
      },
      "defaultCase": []
    }
  ],
  "failureWorkflow": ""
}
