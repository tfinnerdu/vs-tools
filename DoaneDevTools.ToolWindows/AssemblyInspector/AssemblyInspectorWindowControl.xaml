<UserControl
    x:Class="DoaneDevTools.ToolWindows.AssemblyInspector.AssemblyInspectorWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:DoaneDevTools.ToolWindows.AssemblyInspector"
    xmlns:models="clr-namespace:DoaneDevTools.ToolWindows.AssemblyInspector.Models"
    mc:Ignorable="d"
    d:DesignHeight="700"
    d:DesignWidth="900"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <UserControl.Resources>
        <!-- Keyword colors for basic syntax highlighting -->
        <SolidColorBrush x:Key="KeywordBrush" Color="#569CD6"/>
        <SolidColorBrush x:Key="StringBrush"  Color="#CE9178"/>
        <SolidColorBrush x:Key="CommentBrush" Color="#6A9955"/>
        <SolidColorBrush x:Key="TypeBrush"    Color="#4EC9B0"/>

        <!-- TreeView item style: tighter padding, hover highlight -->
        <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="False"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Template for NamespaceNode rows -->
        <HierarchicalDataTemplate DataType="{x:Type models:NamespaceNode}"
                                  ItemsSource="{Binding Types}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xF07B; " Foreground="#DCDC3E" FontFamily="Segoe MDL2 Assets"/>
                <TextBlock Text="{Binding Namespace}" FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Template for TypeNode rows -->
        <HierarchicalDataTemplate DataType="{x:Type models:TypeNode}"
                                  ItemsSource="{Binding Methods}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="C " Foreground="{StaticResource TypeBrush}"
                           FontFamily="Consolas" FontWeight="Bold"/>
                <TextBlock Text="{Binding ShortName}"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <!-- Template for MethodNode rows -->
        <DataTemplate DataType="{x:Type models:MethodNode}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="M " Foreground="{StaticResource KeywordBrush}"
                           FontFamily="Consolas"/>
                <TextBlock Text="{Binding Signature}"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                           FontFamily="Consolas" FontSize="11"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar row -->
            <RowDefinition Height="Auto"/>
            <!-- Members tree -->
            <RowDefinition Height="*" MinHeight="150"/>
            <!-- Splitter -->
            <RowDefinition Height="5"/>
            <!-- Source panel -->
            <RowDefinition Height="*" MinHeight="100"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================================================================
             ROW 0 — Toolbar: Assembly picker + Search
             ================================================================ -->
        <Grid Grid.Row="0" Margin="4,4,4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Assembly ComboBox -->
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding Assemblies}"
                      SelectedItem="{Binding SelectedAssembly}"
                      DisplayMemberPath="Name"
                      Height="24"
                      ToolTip="Select an assembly to inspect"
                      IsEnabled="{Binding IsBusy, Converter={x:Static local:AssemblyInspectorWindowControl.InverseBoolConverter}}"/>

            <!-- Search box -->
            <Grid Grid.Column="2">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="24"
                         Padding="4,2"
                         ToolTip="Filter types and methods"/>
                <TextBlock Text="Search type or method…"
                           IsHitTestVisible="False"
                           Foreground="Gray"
                           Margin="6,4,0,0"
                           FontStyle="Italic">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>

        <!-- ================================================================
             ROW 1 — Members TreeView
             ================================================================ -->
        <Border Grid.Row="1" Margin="4,2"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1">
            <TreeView x:Name="MembersTree"
                      ItemsSource="{Binding Members}"
                      ItemContainerStyle="{StaticResource TreeItemStyle}"
                      Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                      SelectedItemChanged="MembersTree_SelectedItemChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"/>
        </Border>

        <!-- ================================================================
             ROW 2 — Grid Splitter
             ================================================================ -->
        <GridSplitter Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                      ResizeDirection="Rows"
                      ShowsPreview="True"/>

        <!-- ================================================================
             ROW 3 — Source / IL panel
             ================================================================ -->
        <Grid Grid.Row="3" Margin="4,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Panel toolbar: IL toggle, Copy, Open in Tab -->
            <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True" Band="0" BandIndex="0">
                <TextBlock VerticalAlignment="Center" Margin="4,0" FontWeight="SemiBold"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Decompiled C# source — syntax highlighted"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowIL}" Value="True">
                                    <Setter Property="Text" Value="IL Disassembly"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Separator/>
                <ToggleButton x:Name="ILToggle"
                              Content="IL"
                              IsChecked="{Binding ShowIL}"
                              Command="{Binding ToggleILCommand}"
                              Padding="6,2"
                              ToolTip="Toggle between C# and IL view"/>
                <Separator/>
                <Button Content="Copy to clipboard"
                        Command="{Binding CopySourceCommand}"
                        Padding="6,2"/>
                <Button Content="Open in new tab"
                        Padding="6,2"
                        Click="OpenInTabButton_Click"
                        ToolTip="Opens source in an editor tab"/>
            </ToolBar>

            <!-- Source RichTextBox with basic keyword colouring applied in code-behind -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <RichTextBox x:Name="SourceBox"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                             BorderThickness="0"
                             Padding="4"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </Grid>

        <!-- ================================================================
             ROW 4 — Status bar
             ================================================================ -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="80" Height="10" IsIndeterminate="True"
                             Visibility="{Binding IsBusy,
                                 Converter={x:Static local:AssemblyInspectorWindowControl.BoolToVisConverter}}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
