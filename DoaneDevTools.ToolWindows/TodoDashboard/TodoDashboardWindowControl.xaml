<UserControl x:Class="DoaneDevTools.ToolWindows.TodoDashboard.TodoDashboardWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="900"
             Background="#F5F5F5">

    <UserControl.Resources>
        <SolidColorBrush x:Key="DoaneOrange" Color="#FF7900"/>
        <SolidColorBrush x:Key="DoaneNavy"  Color="#1F3864"/>
        <SolidColorBrush x:Key="OldRowBg"   Color="#FFF3E0"/>
        <SolidColorBrush x:Key="VeryOldRowBg" Color="#FFEBEE"/>

        <!-- Toolbar button style -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background"      Value="#E8EDF4"/>
            <Setter Property="Foreground"      Value="#1F3864"/>
            <Setter Property="BorderBrush"     Value="#B0BCD4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="Margin"          Value="0,0,6,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D8E8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#888888"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScanButton" TargetType="Button">
            <Setter Property="Background"      Value="#FF7900"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,4"/>
            <Setter Property="Margin"          Value="0,0,12,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E06A00"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox style aligned with toolbar -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Margin"  Value="0,0,6,0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>

        <!-- DataGrid column header -->
        <Style x:Key="GridColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background"  Value="#1F3864"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="6,5"/>
            <Setter Property="BorderBrush" Value="#2D4A7A"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <!-- Row style: highlight old/very-old items -->
        <Style x:Key="TodoRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVeryOld}" Value="True">
                    <Setter Property="Background" Value="#FFEBEE"/>
                    <Setter Property="ToolTip"    Value="Very old item — over 90 days. Consider resolving."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOld}" Value="True">
                    <Setter Property="Background" Value="#FFF3E0"/>
                    <Setter Property="ToolTip"    Value="Old item — over 30 days."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Type badge colours -->
        <Style x:Key="TypeBadge" TargetType="TextBlock">
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="4,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="FIXME">
                    <Setter Property="Foreground" Value="#C62828"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="HACK">
                    <Setter Property="Foreground" Value="#E65100"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="NOTE">
                    <Setter Property="Foreground" Value="#1565C0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="TODO">
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Summary / status bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0 — Toolbar ────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#1F3864"
                Padding="8,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Scan Solution"
                        Style="{StaticResource ScanButton}"
                        Command="{Binding ScanCommand}"
                        ToolTip="Scan all .cs, .py, .ts, .js, .xaml files for TODO/FIXME/HACK/NOTE"/>

                <TextBlock Text="Filter:"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding FilterTypes}"
                          SelectedItem="{Binding FilterType}"
                          Style="{StaticResource FilterCombo}"
                          ToolTip="Show only items of this type"/>

                <TextBlock Text="Group by:"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <ComboBox ItemsSource="{Binding GroupByOptions}"
                          SelectedItem="{Binding GroupBy}"
                          Style="{StaticResource FilterCombo}"
                          ToolTip="Group grid rows by file or by type"/>

                <Button Content="Export CSV"
                        Style="{StaticResource ToolbarButton}"
                        Command="{Binding ExportCsvCommand}"
                        ToolTip="Export the current list to a CSV file"/>

                <!-- Scanning spinner -->
                <TextBlock Text="Scanning…"
                           Foreground="#FF7900"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Visibility="{Binding IsScanning, Converter={x:Null}, FallbackValue=Collapsed}"/>
            </StackPanel>
        </Border>

        <!-- ── Row 1 — DataGrid ───────────────────────────────────────────── -->
        <DataGrid Grid.Row="1"
                  x:Name="TodoGrid"
                  ItemsSource="{Binding FilteredItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#FAFAFA"
                  ColumnWidth="*"
                  RowStyle="{StaticResource TodoRowStyle}"
                  MouseDoubleClick="OnRowDoubleClick">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background"  Value="#1F3864"/>
                    <Setter Property="Foreground"  Value="White"/>
                    <Setter Property="FontWeight"  Value="SemiBold"/>
                    <Setter Property="Padding"     Value="6,5"/>
                    <Setter Property="BorderBrush" Value="#2D4A7A"/>
                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <!-- Type badge -->
                <DataGridTemplateColumn Header="Type" Width="65" SortMemberPath="Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Type}"
                                       Style="{StaticResource TypeBadge}"
                                       Padding="4,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Message -->
                <DataGridTextColumn Header="Message"
                                   Binding="{Binding Message}"
                                   Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"       Value="4,2"/>
                            <Setter Property="TextTrimming"  Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- File -->
                <DataGridTextColumn Header="File"
                                   Binding="{Binding FileName}"
                                   Width="150"
                                   SortMemberPath="FilePath">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"      Value="4,2"/>
                            <Setter Property="FontFamily"   Value="Consolas, Courier New"/>
                            <Setter Property="FontSize"     Value="11"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Line -->
                <DataGridTextColumn Header="Line"
                                   Binding="{Binding LineNumber}"
                                   Width="55"
                                   SortMemberPath="LineNumber">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"            Value="4,2"/>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontFamily"         Value="Consolas, Courier New"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Author -->
                <DataGridTextColumn Header="Author"
                                   Binding="{Binding Author}"
                                   Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Age -->
                <DataGridTextColumn Header="Age"
                                   Binding="{Binding AgeLabel}"
                                   Width="70"
                                   SortMemberPath="AgeDays">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding"            Value="4,2"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="FontWeight"         Value="SemiBold"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVeryOld}" Value="True">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOld}" Value="True">
                                    <Setter Property="Foreground" Value="#E65100"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Row 2 — Summary / status bar ─────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#1F3864"
                Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Summary counts -->
                <TextBlock Grid.Column="0"
                           Text="{Binding SummaryText}"
                           Foreground="White"
                           FontSize="11"
                           VerticalAlignment="Center"/>

                <!-- Status message -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="#FFB74D"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
