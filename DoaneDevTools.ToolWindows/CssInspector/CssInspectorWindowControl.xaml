<UserControl
    x:Class="DoaneDevTools.ToolWindows.CssInspector.CssInspectorWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:local="clr-namespace:DoaneDevTools.ToolWindows.CssInspector"
    mc:Ignorable="d"
    d:DesignHeight="800"
    d:DesignWidth="1000"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- WebView2 preview -->
            <RowDefinition Height="3*" MinHeight="200"/>
            <!-- Splitter -->
            <RowDefinition Height="5"/>
            <!-- Bottom inspector panels -->
            <RowDefinition Height="2*" MinHeight="200"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====================================================================
             ROW 0 — Toolbar
             ==================================================================== -->
        <ToolBar Grid.Row="0" ToolBarTray.IsLocked="True">

            <!-- File picker -->
            <TextBlock Text="File:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox x:Name="FileCombo"
                      Width="260"
                      ItemsSource="{Binding HtmlFiles}"
                      SelectedItem="{Binding SelectedFile}"
                      DisplayMemberPath="."
                      ToolTip="HTML file to preview"
                      IsEnabled="{Binding IsBusy,
                          Converter={x:Static local:CssInspectorWindowControl.InverseBoolConverter}}"/>

            <Button Content="Reload"
                    Click="ReloadButton_Click"
                    Padding="6,2"
                    Margin="4,0"
                    ToolTip="Reload the current file in the preview"/>

            <Separator/>

            <!-- Responsive viewport picker -->
            <TextBlock Text="Viewport:" VerticalAlignment="Center" Margin="4,0"/>
            <ComboBox x:Name="ViewportCombo"
                      Width="120"
                      SelectedIndex="0"
                      SelectionChanged="ViewportCombo_SelectionChanged"
                      ToolTip="Set the preview viewport size">
                <ComboBoxItem Content="1280×800"  Tag="1280,800"  IsSelected="True"/>
                <ComboBoxItem Content="1920×1080" Tag="1920,1080"/>
                <ComboBoxItem Content="768×1024"  Tag="768,1024"/>
                <ComboBoxItem Content="375×812"   Tag="375,812"/>
                <ComboBoxItem Content="Custom…"   Tag="custom"/>
            </ComboBox>

        </ToolBar>

        <!-- ====================================================================
             ROW 1 — WebView2 live preview
             ==================================================================== -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                BorderThickness="1"
                Margin="4,4,4,0">
            <wv2:WebView2 x:Name="PreviewWebView"
                          NavigationCompleted="PreviewWebView_NavigationCompleted"/>
        </Border>

        <!-- ====================================================================
             ROW 2 — Grid splitter
             ==================================================================== -->
        <GridSplitter Grid.Row="2"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                      ResizeDirection="Rows"
                      ShowsPreview="True"/>

        <!-- ====================================================================
             ROW 3 — Inspector panels
             ==================================================================== -->
        <Grid Grid.Row="3" Margin="4,0,4,4">
            <Grid.ColumnDefinitions>
                <!-- Selected element + Applied rules -->
                <ColumnDefinition Width="*"/>
                <!-- Splitter -->
                <ColumnDefinition Width="5"/>
                <!-- Live edit + Box model -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Selected element and applied rules ──────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Selected element info -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1" Padding="6" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Selected Element"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                        <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">Tag: </Run>
                            <Run Text="{Binding SelectedElement.TagName, FallbackValue='—'}"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">Id: </Run>
                            <Run Text="{Binding SelectedElement.Id, FallbackValue='—'}"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">Class: </Run>
                            <Run Text="{Binding SelectedElement.ClassName, FallbackValue='—'}"/>
                        </TextBlock>
                        <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold">Selector: </Run>
                            <Run Text="{Binding SelectedElement.Selector, FallbackValue='—'}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Applied CSS rules -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Applied CSS Rules"
                                   FontWeight="Bold"
                                   Margin="6,4"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding AppliedRules}" Margin="4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Selector}"
                                                       FontWeight="SemiBold"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       Foreground="#569CD6"/>
                                            <TextBlock Text="{Binding Declaration}"
                                                       FontFamily="Consolas"
                                                       FontSize="10"
                                                       Margin="12,0,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ── Column splitter ──────────────────────────────────────────── -->
            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
                          ResizeDirection="Columns"
                          ShowsPreview="True"/>

            <!-- ── Right: Live edit + box model ─────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Live CSS property editor -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1" Padding="6" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="Live Edit"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="padding:"
                                       VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="PaddingBox"
                                     Text="{Binding LiveEditProperties.Padding, UpdateSourceTrigger=PropertyChanged}"
                                     Height="22" Margin="0,2" FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="margin:"
                                       VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="MarginBox"
                                     Text="{Binding LiveEditProperties.Margin, UpdateSourceTrigger=PropertyChanged}"
                                     Height="22" Margin="0,2" FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="color:"
                                       VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ColorBox"
                                     Text="{Binding LiveEditProperties.Color, UpdateSourceTrigger=PropertyChanged}"
                                     Height="22" Margin="0,2" FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="font-size:"
                                       VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="FontSizeBox"
                                     Text="{Binding LiveEditProperties.FontSize, UpdateSourceTrigger=PropertyChanged}"
                                     Height="22" Margin="0,2" FontFamily="Consolas" FontSize="11"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="background:"
                                       VerticalAlignment="Center" FontFamily="Consolas" FontSize="11"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="BackgroundBox"
                                     Text="{Binding LiveEditProperties.Background, UpdateSourceTrigger=PropertyChanged}"
                                     Height="22" Margin="0,2" FontFamily="Consolas" FontSize="11"/>
                        </Grid>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Apply to preview"
                                    Click="ApplyToPreviewButton_Click"
                                    Padding="8,2" Margin="0,0,4,0"/>
                            <Button Content="Write back to file"
                                    Click="WriteBackToFileButton_Click"
                                    Padding="8,2" Margin="0,0,4,0"/>
                            <Button Content="Copy as CSS"
                                    Click="CopyAsCssButton_Click"
                                    Padding="8,2"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CSS Box model diagram -->
                <Border Grid.Row="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                        BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Box Model"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,8"
                                   Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                        <!-- Margin layer -->
                        <Border x:Name="BoxMargin"
                                Background="#6B4F00" Opacity="0.6"
                                Padding="16" HorizontalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="margin" HorizontalAlignment="Center"
                                           Foreground="White" FontSize="10"/>
                                <!-- Border layer -->
                                <Border x:Name="BoxBorder"
                                        Background="#4A5568" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="border" HorizontalAlignment="Center"
                                                   Foreground="White" FontSize="10"/>
                                        <!-- Padding layer -->
                                        <Border x:Name="BoxPadding"
                                                Background="#2D6A4F" Padding="12">
                                            <StackPanel>
                                                <TextBlock Text="padding" HorizontalAlignment="Center"
                                                           Foreground="White" FontSize="10"/>
                                                <!-- Content layer -->
                                                <Border Background="#1B4F72" Width="80" Height="40">
                                                    <TextBlock Text="content"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="White" FontSize="10"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Dimension labels -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6">
                            <TextBlock FontFamily="Consolas" FontSize="10" Margin="4,0">
                                <Run Text="W: "/>
                                <Run Text="{Binding SelectedElement.Width, FallbackValue='—', StringFormat='{}{0}px'}"/>
                            </TextBlock>
                            <TextBlock FontFamily="Consolas" FontSize="10" Margin="4,0">
                                <Run Text="H: "/>
                                <Run Text="{Binding SelectedElement.Height, FallbackValue='—', StringFormat='{}{0}px'}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- ====================================================================
             ROW 4 — Status bar
             ==================================================================== -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="80" Height="10" IsIndeterminate="True"
                             Visibility="{Binding IsBusy,
                                 Converter={x:Static local:CssInspectorWindowControl.BoolToVisConverter}}"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</UserControl>
