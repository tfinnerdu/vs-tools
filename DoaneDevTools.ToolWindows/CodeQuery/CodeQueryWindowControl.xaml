<UserControl x:Class="DoaneDevTools.ToolWindows.CodeQuery.CodeQueryWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900"
             Background="#1E1E1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D2D" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Code Query" Foreground="#FF7900" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="  — Roslyn Scripting over your solution" Foreground="#888888"
                           FontSize="12" VerticalAlignment="Center"/>
                <Separator Margin="16,0" Background="#444"/>
                <ComboBox ItemsSource="{Binding ExampleQueries}" SelectedItem="{Binding SelectedExample}"
                          Width="300" Background="#3C3C3C" Foreground="#CCCCCC"
                          ToolTip="Load an example query"/>
                <Button Content="Load" Margin="6,0,0,0" Padding="8,3"
                        Background="#1F3864" Foreground="White" BorderThickness="0"
                        Command="{Binding LoadExampleCommand}"/>
            </StackPanel>
        </Border>

        <!-- Query editor -->
        <Border Grid.Row="1" BorderBrush="#444" BorderThickness="0,0,0,1">
            <Grid>
                <TextBox Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#1E1E1E" Foreground="#D4D4D4"
                         FontFamily="Consolas" FontSize="13"
                         AcceptsReturn="True" AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Padding="12"
                         SpellCheck.IsEnabled="False"/>
                <!-- Placeholder -->
                <TextBlock IsHitTestVisible="False"
                           Text="// Write a LINQ query over your codebase&#x0a;// Available globals: Methods, Types, Compilation, Metrics&#x0a;// Example: from m in Methods where m.Parameters.Length &gt; 5 select m.ContainingType.Name + &quot;.&quot; + m.Name"
                           Foreground="#555555" FontFamily="Consolas" FontSize="12"
                           Margin="12" VerticalAlignment="Top"
                           Visibility="{Binding IsQueryEmpty, Converter={StaticResource BoolVis}}"/>
            </Grid>
        </Border>

        <!-- Run bar -->
        <Border Grid.Row="2" Background="#252526" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="▶ Run Query" Padding="12,5" FontWeight="SemiBold"
                        Background="#FF7900" Foreground="White" BorderThickness="0"
                        Command="{Binding RunQueryCommand}"/>
                <Button Content="Clear" Padding="8,5" Margin="6,0,0,0"
                        Background="#3C3C3C" Foreground="#CCCCCC" BorderThickness="0"
                        Command="{Binding ClearCommand}"/>
                <Separator Margin="8,0" Background="#444"/>
                <TextBlock Text="{Binding StatusText}" Foreground="#888888"
                           FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" ItemsSource="{Binding Results}"
                      AutoGenerateColumns="True" IsReadOnly="True"
                      Background="#1E1E1E" Foreground="#D4D4D4"
                      GridLinesVisibility="None"
                      RowBackground="#252526" AlternatingRowBackground="#2A2A2A"
                      HeadersVisibility="Column"
                      BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#3C3C3C"/>
                        <Setter Property="Foreground" Value="#CCCCCC"/>
                        <Setter Property="Padding" Value="8,4"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#444"/>

            <Border Grid.Row="2" Background="#1C1C1C" Padding="8">
                <TextBox Text="{Binding ErrorText}" IsReadOnly="True"
                         Background="Transparent" Foreground="#F48771"
                         FontFamily="Consolas" FontSize="11"
                         BorderThickness="0" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
