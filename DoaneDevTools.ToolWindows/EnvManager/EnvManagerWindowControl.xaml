<UserControl x:Class="DoaneDevTools.ToolWindows.EnvManager.EnvManagerWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DoaneDevTools.ToolWindows.EnvManager"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#F5F5F5">

    <UserControl.Resources>
        <!-- Brand colours -->
        <SolidColorBrush x:Key="DoaneOrange" Color="#FF7900"/>
        <SolidColorBrush x:Key="DoaneNavy"  Color="#1F3864"/>

        <!-- Header style -->
        <Style x:Key="HeaderBar" TargetType="Border">
            <Setter Property="Background" Value="#1F3864"/>
            <Setter Property="Padding"    Value="8,4"/>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="#FF7900"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="10,4"/>
            <Setter Property="Margin"       Value="4,0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E06A00"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background"   Value="#E8EDF4"/>
            <Setter Property="Foreground"   Value="#1F3864"/>
            <Setter Property="BorderBrush"  Value="#1F3864"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"      Value="10,4"/>
            <Setter Property="Margin"       Value="4,0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D0D8E8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Foreground" Value="#666666"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Section header label -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Background"  Value="#1F3864"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="6,3"/>
        </Style>

        <!-- TreeView item -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar row -->
            <RowDefinition Height="Auto"/>
            <!-- Main content -->
            <RowDefinition Height="*"/>
            <!-- Bottom action bar -->
            <RowDefinition Height="Auto"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Row 0 — Toolbar ────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Active Profile:"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <ComboBox Width="120"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding ActiveProfile}"
                          DisplayMemberPath="Name"
                          ToolTip="Select the active environment profile"/>

                <Button Content="New Profile"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NewProfileCommand}"
                        ToolTip="Create a new empty profile"/>

                <Button Content="Duplicate"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DuplicateProfileCommand}"
                        ToolTip="Clone the active profile with a new name"/>

                <Button Content="Delete"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding DeleteProfileCommand}"
                        ToolTip="Delete the active profile"/>
            </StackPanel>
        </Border>

        <!-- ── Row 1 — Two-panel content ─────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Projects & Files panel -->
            <Border Grid.Column="0"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Background="White">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionHeader}"
                               Text="Projects &amp; Files"/>

                    <TreeView ItemsSource="{Binding ProjectFiles}"
                              Background="Transparent"
                              BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <!-- Folder vs file icon -->
                                        <TextBlock Text="{Binding Icon}"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Margin="0,0,4,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="#1F3864"/>
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LinkStatus}"
                                               Foreground="#2E7D32"
                                               FontSize="10"
                                               Margin="8,0,2,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="#DDDDDD"
                          ShowsPreview="True"/>

            <!-- Right: Variable grid -->
            <Border Grid.Column="2"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Background="White">
                <DockPanel>
                    <!-- Section header showing active profile name -->
                    <TextBlock DockPanel.Dock="Top"
                               Style="{StaticResource SectionHeader}">
                        <Run Text="Profile: "/>
                        <Run Text="{Binding ActiveProfile.Name, FallbackValue='(none)'}"/>
                    </TextBlock>

                    <!-- Variable toolbar -->
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                Margin="4,4,4,2">
                        <Button Content="Add Variable"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding AddVariableCommand}"
                                ToolTip="Append a new key/value row"/>
                        <Button Content="Import .env"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ImportEnvCommand}"
                                ToolTip="Import variables from an existing .env file"/>
                    </StackPanel>

                    <!-- Key/value DataGrid -->
                    <DataGrid ItemsSource="{Binding ActiveProfileVariables}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FAFAFA"
                              ColumnWidth="*">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#E8EDF4"/>
                                <Setter Property="Foreground" Value="#1F3864"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding"    Value="6,4"/>
                                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <!-- Key column — editable -->
                            <DataGridTextColumn Header="Key"
                                               Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                               Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                        <Setter Property="FontSize"   Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Value column — shows [encrypted] for secrets -->
                            <DataGridTextColumn Header="Value"
                                               Binding="{Binding DisplayValue}"
                                               Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                        <Setter Property="FontSize"   Value="12"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                                <Setter Property="Foreground" Value="#888888"/>
                                                <Setter Property="FontStyle"  Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Secret toggle -->
                            <DataGridCheckBoxColumn Header="Secret"
                                                   Binding="{Binding IsSecret, UpdateSourceTrigger=PropertyChanged}"
                                                   Width="60">
                                <DataGridCheckBoxColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#E8EDF4"/>
                                        <Setter Property="Foreground" Value="#1F3864"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding"    Value="6,4"/>
                                    </Style>
                                </DataGridCheckBoxColumn.HeaderStyle>
                            </DataGridCheckBoxColumn>
                        </DataGrid.Columns>

                        <!-- Row tooltip showing actual value when row is selected -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSecret}" Value="True">
                                        <Setter Property="ToolTip" Value="Value hidden — marked as secret"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ── Row 2 — Bottom action bar ─────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="#E8EDF4"
                BorderBrush="#CCCCCC"
                BorderThickness="0,1,0,0"
                Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApplyToAllCommand}"
                        ToolTip="Write the active profile's variables to every linked file">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Apply "/>
                            <TextBlock Text="{Binding ActiveProfile.Name, FallbackValue='Profile', StringFormat='&quot;{0}&quot;'}"/>
                            <TextBlock Text=" to all linked files"/>
                        </StackPanel>
                    </Button.Content>
                </Button>

                <Button Content="Validate"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ValidateCommand}"
                        ToolTip="Cross-check variables across all linked files"/>

                <Button Content="Export Schema"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportSchemaCommand}"
                        ToolTip="Save devtools.profiles.schema.json for IDE validation"/>
            </StackPanel>
        </Border>

        <!-- ── Row 3 — Status bar ────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="#1F3864"
                Padding="8,3">
            <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}"
                       Foreground="White"
                       FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
