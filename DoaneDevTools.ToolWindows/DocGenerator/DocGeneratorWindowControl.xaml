<UserControl
    x:Class="DoaneDevTools.ToolWindows.DocGenerator.DocGeneratorWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:DoaneDevTools.ToolWindows.DocGenerator"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="700"
    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <!-- Project picker -->
            <RowDefinition Height="Auto"/>
            <!-- Output path -->
            <RowDefinition Height="Auto"/>
            <!-- Options -->
            <RowDefinition Height="Auto"/>
            <!-- Action buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Progress -->
            <RowDefinition Height="Auto"/>
            <!-- Log output -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ====================================================================
             ROW 0 — Project / Solution picker
             ==================================================================== -->
        <GroupBox Grid.Row="0" Header="Source" Margin="0,0,0,8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Select projects to document (Ctrl+Click for multi-select):"
                           Margin="0,0,0,4"
                           Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>

                <ListBox Grid.Row="1" Grid.Column="0"
                         x:Name="ProjectList"
                         ItemsSource="{Binding Projects}"
                         SelectionMode="Extended"
                         Height="80"
                         SelectionChanged="ProjectList_SelectionChanged"
                         IsEnabled="{Binding IsBusy,
                             Converter={x:Static local:DocGeneratorWindowControl.InverseBoolConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                    <Button Content="Refresh"
                            Click="RefreshProjectsButton_Click"
                            Padding="6,2" Margin="0,0,0,4"
                            IsEnabled="{Binding IsBusy,
                                Converter={x:Static local:DocGeneratorWindowControl.InverseBoolConverter}}"/>
                    <Button Content="Select all"
                            Click="SelectAllButton_Click"
                            Padding="6,2"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ====================================================================
             ROW 1 — Output path
             ==================================================================== -->
        <GroupBox Grid.Row="1" Header="Output" Margin="0,0,0,8" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                         Height="24"
                         Padding="4,2"
                         FontFamily="Consolas" FontSize="11"
                         ToolTip="Folder where the HTML doc site will be generated"
                         IsEnabled="{Binding IsBusy,
                             Converter={x:Static local:DocGeneratorWindowControl.InverseBoolConverter}}"/>

                <Button Grid.Column="1"
                        Content="Browse…"
                        Click="BrowseOutputButton_Click"
                        Padding="8,2"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding IsBusy,
                            Converter={x:Static local:DocGeneratorWindowControl.InverseBoolConverter}}"/>
            </Grid>
        </GroupBox>

        <!-- ====================================================================
             ROW 2 — Options
             ==================================================================== -->
        <GroupBox Grid.Row="2" Header="Options" Margin="0,0,0,8" Padding="8">
            <StackPanel>
                <CheckBox Content="Generate XML doc comments for undocumented members"
                          IsChecked="{Binding GenerateXmlDocs}"
                          Margin="0,0,0,4"
                          IsEnabled="{Binding IsBusy,
                              Converter={x:Static local:DocGeneratorWindowControl.InverseBoolConverter}}"/>
                <CheckBox Content="Generate static HTML site from XML documentation"
                          IsChecked="{Binding GenerateHtmlSite}"
                          Margin="0,0,0,4"
                          IsEnabled="{Binding IsBusy,
                              Converter={x:Static local:DocGeneratorWindowControl.InverseBoolConverter}}"/>
                <CheckBox Content="Open output folder when complete"
                          IsChecked="{Binding OpenWhenComplete}"
                          IsEnabled="{Binding IsBusy,
                              Converter={x:Static local:DocGeneratorWindowControl.InverseBoolConverter}}"/>
            </StackPanel>
        </GroupBox>

        <!-- ====================================================================
             ROW 3 — Action buttons
             ==================================================================== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Generate Doc Site"
                    Command="{Binding GenerateCommand}"
                    Padding="12,4"
                    FontWeight="SemiBold"
                    Background="#1F3864"
                    Foreground="White"
                    Margin="0,0,8,0"/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="12,4"/>
        </StackPanel>

        <!-- ====================================================================
             ROW 4 — Progress bar
             ==================================================================== -->
        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <ProgressBar x:Name="ProgressBar"
                         Value="{Binding Progress}"
                         Maximum="100"
                         Height="16"
                         Margin="0,0,0,4"/>
            <TextBlock Text="{Binding ProgressLabel}"
                       FontSize="11"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        </StackPanel>

        <!-- ====================================================================
             ROW 5 — Log output
             ==================================================================== -->
        <GroupBox Grid.Row="5" Header="Log" Padding="4">
            <ScrollViewer x:Name="LogScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="LogBox"
                         Text="{Binding LogOutput}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                         Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
                         BorderThickness="0"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"/>
            </ScrollViewer>
        </GroupBox>

    </Grid>
</UserControl>
