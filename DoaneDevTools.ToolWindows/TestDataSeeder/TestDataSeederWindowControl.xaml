<UserControl x:Class="DoaneDevTools.ToolWindows.TestDataSeeder.TestDataSeederWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900"
             Background="#F5F5F5">

    <UserControl.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DoaneButton" TargetType="Button">
            <Setter Property="Background" Value="#1F3864"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource DoaneButton}">
            <Setter Property="Background" Value="#FF7900"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1F3864" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Connection:" Style="{StaticResource HeaderStyle}" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" Width="200" ItemsSource="{Binding SavedConnections}"
                          SelectedItem="{Binding SelectedConnection}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="Database:" Style="{StaticResource HeaderStyle}" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="3" Width="150" ItemsSource="{Binding Databases}"
                          SelectedItem="{Binding SelectedDatabase}" Margin="0,0,12,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <TextBlock Text="Default count:" Style="{StaticResource HeaderStyle}" Margin="0,0,8,0"/>
                    <TextBox Width="60" Text="{Binding DefaultSeedCount}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Load Schema" Style="{StaticResource OrangeButton}"
                            Command="{Binding LoadSchemaCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Circular dependency warnings -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding CircularDependencyWarnings}"
                      Visibility="{Binding HasCircularWarnings, Converter={StaticResource BoolVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#FFF3CD" BorderBrush="#FF7900" BorderThickness="0,0,0,1" Padding="12,4">
                        <TextBlock Text="{Binding}" Foreground="#856404" FontSize="12"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Table grid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Tables}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,0,0">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
                <DataGridTextColumn Header="Table" Binding="{Binding FullName}" Width="220" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Count" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding SeedCount, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Strategy" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox SelectedItem="{Binding Strategy, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding DataContext.AvailableStrategies,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      BorderThickness="0" Background="Transparent"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="FK Dependencies" Width="*"
                                    Binding="{Binding ForeignKeyDependencies[0]}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action bar -->
        <Border Grid.Row="3" Background="#E8EAF0" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="Preview SQL" Style="{StaticResource DoaneButton}" Command="{Binding PreviewCommand}"/>
                <Button Content="Seed Now" Style="{StaticResource OrangeButton}" Command="{Binding SeedCommand}"/>
                <Button Content="Clear All" Style="{StaticResource DoaneButton}" Command="{Binding ClearAllCommand}"/>
                <Button Content="Export as SQL Script" Style="{StaticResource DoaneButton}" Command="{Binding ExportScriptCommand}"/>
                <Separator Margin="8,0"/>
                <ProgressBar Width="150" Height="16" Value="{Binding SeedProgress}" Maximum="100"
                             Visibility="{Binding IsSeeding, Converter={StaticResource BoolVis}}"
                             Foreground="#FF7900"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="8,0"
                           Foreground="#1F3864" FontSize="11"/>
            </StackPanel>
        </Border>

        <!-- Log output -->
        <Border Grid.Row="4" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="#2D2D2D" Padding="8,3">
                    <TextBlock Text="Output" Foreground="#AAAAAA" FontSize="11"/>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding LogOutput}" IsReadOnly="True" Background="Transparent"
                             Foreground="#DCDCDC" FontFamily="Consolas" FontSize="11"
                             BorderThickness="0" TextWrapping="Wrap" Padding="8"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
